<Application x:Class="Scanner.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#E3EAF1"/><SolidColorBrush x:Key="Accent" Color="#65D6BE"/>
